{
  "manifest_version": 3,
  "name": "Follow Tracker Auto",
  "description": "Analiza followers/following de un perfil de Instagram en 1 clic, sin consola.",
  "version": "1.3.10",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "action": {
    "default_title": "Follow Tracker Auto",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
